# ══════════════════════════════════════════════════════════════════════════════
#  NobatYar — Production Environment Variables
#
#  HOW TO USE:
#    cp backend/.env.prod.example backend/.env.prod
#    # edit every CHANGE-ME value before deploying
#
#  Docker Compose variable substitution (${DB_NAME} etc. in docker-compose.prod.yml)
#  reads from a .env file in the PROJECT ROOT, not from this file directly.
#  Two ways to handle this:
#    Option A (recommended): symlink at project root
#      ln -s backend/.env.prod .env
#    Option B: pass the file explicitly
#      docker compose --env-file backend/.env.prod -f docker-compose.prod.yml up -d
# ══════════════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE-ME-generate-with-get-random-secret-key

DEBUG=False

# Comma-separated. Must include your real domain(s).
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=nobatYar_prod
DB_USER=nobatYar_user
DB_PASSWORD=CHANGE-ME-strong-random-password
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Zarinpal ─────────────────────────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=CHANGE-ME-your-36-char-merchant-uuid
ZARINPAL_SANDBOX=False
# Must be publicly reachable by Zarinpal's servers for payment callbacks.
ZARINPAL_CALLBACK_BASE_URL=https://yourdomain.com

# ── Kavenegar SMS ────────────────────────────────────────────────────────────
KAVENEGAR_API_KEY=CHANGE-ME-your-api-key

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_BASE_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Sentry (optional but strongly recommended for production) ─────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
